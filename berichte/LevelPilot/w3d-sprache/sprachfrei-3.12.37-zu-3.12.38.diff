 LP.W3D = LP.W3D or false
 function Graph.On() return LP.W3D == true end
 
+-- 3.12.38 W3D sprachfrei (Supervisor 21:48): GetSubZoneText ist uebersetzt ("Magieviertel" / "The Magic Quarter"). Fuer Orte
+-- mit Ebenen gibt es eine Tabelle Data/AreaNames.lua (wago.tools AreaTable + WMOAreaTable, Zweig wowf):
+-- LP.AreaNames = { ["<Schluessel>"] = { deDE = "Name", enUS = "Name", ..., alt = { weitere Namen derselben Ebene } } },
+-- Schluessel "<AreaID>" bzw. "<AreaID>:<enUS-Name>" (Supervisor 22:03: gleiche AreaID + gleicher enUS-Name = gleiche Ebene;
+-- Unterstadt hat zwei Gebaeude mit "Magieviertel" / "Das Magieviertel"). Ein bekannter Name wird zu "#<Schluessel>",
+-- ein unbekannter bleibt der Name selbst (wie bisher).
+local subIdx
+local function SubIndex()
+    if subIdx then return subIdx end
+    subIdx = {}
+    local function add(n, key)
+        -- gleicher Name fuer zwei Schluessel (z. B. "Darnassus" = Stadt und Raum): immer der kleinere (feste Wahl,
+        -- unabhaengig von der Reihenfolge von pairs). Die Karte steht ohnehin vorn in der Ebenen-Angabe.
+        if type(n) == "string" and n ~= "" and (not subIdx[n] or key < subIdx[n]) then subIdx[n] = key end
+    end
+    for key, names in pairs(LP.AreaNames or {}) do
+        if type(names) == "table" then
+            key = tostring(key)
+            for loc, n in pairs(names) do
+                if loc == "alt" and type(n) == "table" then
+                    for _, a in ipairs(n) do add(a, key) end
+                else
+                    add(n, key)
+                end
+            end
+        end
+    end
+    return subIdx
+end
+function Graph.ResetSubIndex() subIdx = nil end
+function Graph.SubKey(sub)
+    if type(sub) ~= "string" or sub == "" then return "" end
+    local id = SubIndex()[sub]
+    return id and ("#" .. id) or sub
+end
+-- Anzeige: "#<Schluessel>" -> Name in der Sprache des Spiels (sonst Englisch); andere Texte unveraendert
+function Graph.SubName(sub)
+    if type(sub) ~= "string" then return sub end
+    local key = sub:match("^#(.+)$")
+    local names = key and LP.AreaNames and LP.AreaNames[key]
+    if type(names) ~= "table" then return sub end
+    local loc = GetLocale and GetLocale()
+    if type(names[loc]) == "string" then return names[loc] end
+    if type(names.enUS) == "string" then return names.enUS end
+    return key:match(":(.+)$") or sub
+end
+-- "Karte|d|Name" -> "Karte|d|#ID" (unbekannte Namen und schon umgeschriebene Angaben bleiben)
+function Graph.LvSprachfrei(lv)
+    if type(lv) ~= "string" then return lv end
+    local head, sub = lv:match("^([^|]*|[^|]*)|(.*)$")
+    if not head or sub == "" or sub:sub(1, 1) == "#" then return lv end
+    local k = Graph.SubKey(sub)
+    return k == sub and lv or (head .. "|" .. k)
+end
+
 -- Ebenen-Angabe am Spieler: "Karte|d|Unterzone" (d = drinnen) bzw. "Karte|o|Unterzone" (draussen)
 function Graph.LevelInfo()
     local S = LP.SafeValue
     local map = C_Map and C_Map.GetBestMapForUnit and S(C_Map.GetBestMapForUnit("player")) or 0
     local indoors = IsIndoors and S(IsIndoors()) and true or false
     local sub = GetSubZoneText and S(GetSubZoneText()) or ""
-    return tostring(map or 0) .. "|" .. (indoors and "d" or "o") .. "|" .. tostring(sub or ""), indoors
+    return tostring(map or 0) .. "|" .. (indoors and "d" or "o") .. "|" .. Graph.SubKey(tostring(sub or "")), indoors
 end
 
