 LP.W3D = LP.W3D or false
 function Graph.On() return LP.W3D == true end
 
+-- 3.12.38 W3D sprachfrei (Supervisor 21:48): GetSubZoneText ist uebersetzt ("Magieviertel" / "The Magic Quarter"). Fuer Orte
+-- mit Ebenen gibt es eine Tabelle Data/AreaNames.lua: LP.AreaNames = { [AreaTable-ID] = { deDE = "Name", enUS = "Name", ... } }
+-- (alle Client-Sprachen). Ein bekannter Name wird zu "#ID", ein unbekannter bleibt der Name selbst (wie bisher).
+local subIdx
+local function SubIndex()
+    if subIdx then return subIdx end
+    subIdx = {}
+    for id, names in pairs(LP.AreaNames or {}) do
+        if type(names) == "table" then
+            for _, n in pairs(names) do
+                -- gleicher Name fuer zwei IDs: immer die kleinere (feste Wahl, unabhaengig von der Reihenfolge von pairs)
+                if type(n) == "string" and n ~= "" and (not subIdx[n] or id < subIdx[n]) then subIdx[n] = id end
+            end
+        end
+    end
+    return subIdx
+end
+function Graph.ResetSubIndex() subIdx = nil end
+function Graph.SubKey(sub)
+    if type(sub) ~= "string" or sub == "" then return "" end
+    local id = SubIndex()[sub]
+    return id and ("#" .. id) or sub
+end
+-- Anzeige: "#ID" -> Name in der Sprache des Spiels (sonst Englisch, sonst irgendeiner); andere Texte unveraendert
+function Graph.SubName(sub)
+    if type(sub) ~= "string" then return sub end
+    local id = tonumber(sub:match("^#(%d+)$") or "")
+    local names = id and LP.AreaNames and LP.AreaNames[id]
+    if not names then return sub end
+    local loc = GetLocale and GetLocale()
+    if names[loc] then return names[loc] end
+    if names.enUS then return names.enUS end
+    for _, n in pairs(names) do return n end
+    return sub
+end
+-- "Karte|d|Name" -> "Karte|d|#ID" (unbekannte Namen und schon umgeschriebene Angaben bleiben)
+function Graph.LvSprachfrei(lv)
+    if type(lv) ~= "string" then return lv end
+    local head, sub = lv:match("^([^|]*|[^|]*)|(.*)$")
+    if not head or sub == "" or sub:sub(1, 1) == "#" then return lv end
+    local k = Graph.SubKey(sub)
+    return k == sub and lv or (head .. "|" .. k)
+end
+
 -- Ebenen-Angabe am Spieler: "Karte|d|Unterzone" (d = drinnen) bzw. "Karte|o|Unterzone" (draussen)
 function Graph.LevelInfo()
     local S = LP.SafeValue
     local map = C_Map and C_Map.GetBestMapForUnit and S(C_Map.GetBestMapForUnit("player")) or 0
     local indoors = IsIndoors and S(IsIndoors()) and true or false
     local sub = GetSubZoneText and S(GetSubZoneText()) or ""
-    return tostring(map or 0) .. "|" .. (indoors and "d" or "o") .. "|" .. tostring(sub or ""), indoors
+    return tostring(map or 0) .. "|" .. (indoors and "d" or "o") .. "|" .. Graph.SubKey(tostring(sub or "")), indoors
 end
 
