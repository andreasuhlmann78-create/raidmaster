+-- W3D (Entwurf, unveroeffentlicht): Ebenen-Schluessel je Knoten. nil = draussen (wie bisher, ein Schluessel je Zone);
+-- drinnen "i:<Unterzone>". Zusammenlegen (SNAP), Anhaengen (Join) und Luftlinien nur innerhalb desselben Schluessels;
+-- drinnen keine Luftlinien zwischen Knoten. Welche Zeichen die Ebene wirklich trennen, klaert die Messung (GSWegMess);
+-- darum ist die Schluessel-Funktion austauschbar (Graph.LevelKey).
+------------------------------------------------------------------------
+function Graph.LevelKey()
+    local indoors = IsIndoors and LP.SafeValue(IsIndoors())
+    if not indoors then return nil end
+    local sub = GetSubZoneText and LP.SafeValue(GetSubZoneText()) or ""
+    return "i:" .. tostring(sub or "")
+end
+local function SameKey(a, b) return (a and a.k) == (b and b.k) end
+-- Zonen, die ganz aus Raeumen auf mehreren Ebenen bestehen: dort nie Luftlinien zwischen Knoten, auch fuer aeltere
+-- Knoten ohne Schluessel (Unterstadt: eine Karte fuer Ring, Viertel, Kanaele – wago.tools UiMap, Supervisor 15.11.)
+Graph.INDOOR_ZONES = { [1458] = true }
+Graph.SameKey = SameKey
