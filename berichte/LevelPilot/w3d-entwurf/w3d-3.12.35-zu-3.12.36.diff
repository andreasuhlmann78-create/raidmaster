+-- W3D B5 (Entwurf, nur bei LP.W3D): ein Satz je Tor. Der Pfeil zeigt ohnehin auf den naechsten Wegpunkt (das Tor).
+------------------------------------------------------------------------
+local function SubOf(lv) return lv and lv:match("^[^|]*|[^|]*|(.*)$") or nil end
+function N.GateText(e, toNode)
+    local sub = SubOf(LP.Graph and LP.Graph.LvName and LP.Graph.LvName(toNode) or (toNode and toNode.lv))
+    sub = (sub and sub ~= "") and sub or nil
+    if e.lift then return sub and L("Aufzug nehmen (nach %s)", sub) or L["Aufzug nehmen"] end
+    if e.ow then return sub and L("Hier hinunterspringen (nach %s)", sub) or L["Hier hinunterspringen"] end
+    return sub and L("Übergang nach %s", sub) or L["Übergang zur anderen Ebene"]
+end
+function N:GateHint()
+    local G = LP.Graph
+    if not (G and G.On and G.On()) or not path then return nil end
+    local pi, pn, pw = LP.Geo:Player()
+    -- falsche Ebene: der naechste Wegpunkt liegt drinnen auf einer anderen Ebene als der Spieler
+    local nextP = path[pathIdx]
+    local nd = nextP and nextP.id and G:NodeById(nextP.id)
+    if nd and nd.k then
+        local lv, indoors = G.LevelInfo()
+        local me = indoors and lv or nil
+        if me and me ~= nd.k and pi and pn then
+            return L("Andere Ebene – zurück zum Übergang (%s)", LP:FormatDist(LP.Geo:Dist(pn, pw, nextP[2], nextP[3])))
+        end
+    end
+    for i = math.max(2, pathIdx), #path do
+        local a, b = path[i - 1], path[i]
+        if a.id and b.id then
+            local adj = G:Neighbors(a.id)
+            local e = adj and adj[b.id]
+            if e and e.g then
+                local d = (pi and pn) and LP.Geo:Dist(pn, pw, a[2], a[3]) or 0
+                return N.GateText(e, G:NodeById(b.id)) .. " · " .. LP:FormatDist(d)
+            end
+        end
+    end
+    return nil
+end
