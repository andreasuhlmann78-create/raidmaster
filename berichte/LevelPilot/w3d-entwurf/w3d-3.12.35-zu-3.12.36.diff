+-- Ebenen-Angabe am Spieler: "Karte|d|Unterzone" (d = drinnen) bzw. "Karte|o|Unterzone" (draussen)
+function Graph.LevelInfo()
+    local S = LP.SafeValue
+    local map = C_Map and C_Map.GetBestMapForUnit and S(C_Map.GetBestMapForUnit("player")) or 0
+    local indoors = IsIndoors and S(IsIndoors()) and true or false
+    local sub = GetSubZoneText and S(GetSubZoneText()) or ""
+    return tostring(map or 0) .. "|" .. (indoors and "d" or "o") .. "|" .. tostring(sub or ""), indoors
+end
+
+-- Nummer einer Ebenen-Angabe (neu angelegt, solange Platz ist)
+function Graph.LvId(lv)
+    if type(lv) ~= "string" or not G then return nil end
+    local i = lvIdx[lv]
+    if i then return i end
+    if #G.lvs >= MAX_LVS then return nil end
+    G.lvs[#G.lvs + 1] = lv
+    lvIdx[lv] = #G.lvs
+    return #G.lvs
+end
+-- Ebenen-Angabe eines Knotens als Text (nil = keine)
+function Graph.LvName(nd)
+    local v = nd and nd.lv
+    if type(v) == "string" then return v end
+    return v and G and G.lvs and G.lvs[v] or nil
+end
+
+-- Schluessel fuer das Wegnetz: nil = draussen (wie bisher), drinnen die Ebenen-Angabe
+function Graph.LevelKey()
+    local lv, indoors = Graph.LevelInfo()
+    if not indoors then return nil end
+    return lv
+end
